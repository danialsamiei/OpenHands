OPENHANDS_BUILD_VERSION=qadr-fa
AGENT_SERVER_BASE_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
AGENT_SERVER_BASE_IMAGE_TAG=1.12.0-python
AGENT_SERVER_IMAGE_REPOSITORY=gantor/openhands-agent-server
AGENT_SERVER_IMAGE_TAG=qadr-pw
SANDBOX_HOST_PORT=39030
SANDBOX_USER_ID=0
SANDBOX_DOCKER_NETWORK=fgpt_ai
SANDBOX_STARTUP_GRACE_SECONDS=90
OPENHANDS_PORT=39030
OPENHANDS_STATE_DIR=/srv/data/openhands-state
OPENHANDS_WORKSPACE_DIR=/srv/data/openhands-workspace
SANDBOX_CONTAINER_URL_PATTERN=https://hands.gantor.ir/runtime/{port}
SANDBOX_INTERNAL_CONTAINER_URL_PATTERN=http://{sandbox_id}:8000
SANDBOX_WEBHOOK_BASE_URL=http://qadr-openhands:3000/api/v1/webhooks
OH_WEB_URL=https://hands.gantor.ir
OH_INTERNAL_MCP_URL=http://qadr-openhands:3000
OH_PERMITTED_CORS_ORIGINS_0=https://hands.gantor.ir
WEB_HOST=hands.gantor.ir
OPENHANDS_CONFIG_CLS=openhands.qadr.server_config.QadrServerConfig
FREEGPT_OPENHANDS_REQUIRE_LOGIN=true
FREEGPT_AUTH_BASE_URL=http://qadr-openwebui-app:8080
FREEGPT_OPENHANDS_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
FREEGPT_OPENHANDS_DEFAULT_LANGUAGE=fa
FREEGPT_OPENHANDS_INTERNAL_MCP_HOSTS=qadr-openhands:3000,openhands:3000,host.docker.internal:39030,127.0.0.1:39030,localhost:39030
HIDE_LLM_SETTINGS=true
AUTH_URL=https://hands.gantor.ir/auth/login
QADR_OPENHANDS_LLM_MODEL=ollama/qwen2.5:3b
QADR_OPENHANDS_OLLAMA_BASE_URL=http://qadr-local-llm-ollama:11434
QADR_OPENHANDS_OLLAMA_API_KEY=ollama-local-placeholder
QADR_OPENHANDS_GATEWAY_BASE_URL=http://qadr-ai-gateway-litellm:4000/v1
QADR_OPENHANDS_GATEWAY_API_KEY=REPLACE_WITH_GATEWAY_SERVICE_KEY
QADR_OPENHANDS_EFFECTIVE_LLM_BASE_URL=http://qadr-local-llm-ollama:11434
QADR_OPENHANDS_EFFECTIVE_LLM_API_KEY=ollama-local-placeholder
FREEGPT_OPENHANDS_ENFORCE_LLM_DEFAULTS=true
FREEGPT_OPENHANDS_INTERNAL_WEBHOOK_CIDRS=172.19.0.0/16,127.0.0.1/32,::1/128
FREEGPT_OPENHANDS_LOAD_PUBLIC_SKILLS=false
FREEGPT_OPENHANDS_LOAD_USER_SKILLS=false
FREEGPT_OPENHANDS_LOAD_PROJECT_SKILLS=true
FREEGPT_OPENHANDS_LOAD_ORG_SKILLS=false
QADR_OPENHANDS_LLM_TIMEOUT=360
QADR_OPENHANDS_LLM_MAX_MESSAGE_CHARS=12000
QADR_OPENHANDS_LLM_MAX_OUTPUT_TOKENS=1200
QADR_OPENHANDS_LLM_NUM_RETRIES=2
QADR_OPENHANDS_LLM_RETRY_MIN_WAIT=2
QADR_OPENHANDS_LLM_RETRY_MAX_WAIT=8
QADR_OPENHANDS_LLM_RETRY_MULTIPLIER=2
QADR_OPENHANDS_LLM_TEMPERATURE=0.0
QADR_OPENHANDS_LLM_CACHING_PROMPT=false
QADR_OPENHANDS_LLM_NATIVE_TOOL_CALLING=true
QADR_OPENHANDS_LLM_DISABLE_STOP_WORD=false
QADR_OPENHANDS_LLM_REASONING_EFFORT=none
QADR_OPENHANDS_LLM_ENABLE_ENCRYPTED_REASONING=false
QADR_OPENHANDS_LLM_EXTENDED_THINKING_BUDGET=0
